# Template for passwords.yaml
# Copy this file to passwords.yaml and fill in actual values
# NEVER commit passwords.yaml to git!

# Save passwords used across all configurations here.
shared:
  mySharedPassword: 'REPLACE_WITH_ACTUAL_PASSWORD'

# These are passwords used when running the server locally in development mode
development:
  database: 'REPLACE_WITH_DEV_DB_PASSWORD'
  redis: 'REPLACE_WITH_DEV_REDIS_PASSWORD'

  # The service secret is used to communicate between servers and to access the
  # service protocol.
  serviceSecret: 'REPLACE_WITH_DEV_SERVICE_SECRET'

  emailSecretHashPepper: 'REPLACE_WITH_DEV_EMAIL_PEPPER'
  jwtHmacSha512PrivateKey: 'REPLACE_WITH_DEV_JWT_KEY'
  jwtRefreshTokenHashPepper: 'REPLACE_WITH_DEV_JWT_REFRESH_PEPPER'

test:
  database: 'REPLACE_WITH_TEST_DB_PASSWORD'
  redis: 'REPLACE_WITH_TEST_REDIS_PASSWORD'

  emailSecretHashPepper: 'REPLACE_WITH_TEST_EMAIL_PEPPER'
  jwtHmacSha512PrivateKey: 'REPLACE_WITH_TEST_JWT_KEY'
  jwtRefreshTokenHashPepper: 'REPLACE_WITH_TEST_JWT_REFRESH_PEPPER'

# Passwords used in your staging environment if you use one.
staging:
  database: 'REPLACE_WITH_STAGING_DB_PASSWORD'
  serviceSecret: 'REPLACE_WITH_STAGING_SERVICE_SECRET'

  emailSecretHashPepper: 'REPLACE_WITH_STAGING_EMAIL_PEPPER'
  jwtHmacSha512PrivateKey: 'REPLACE_WITH_STAGING_JWT_KEY'
  jwtRefreshTokenHashPepper: 'REPLACE_WITH_STAGING_JWT_REFRESH_PEPPER'

# Passwords used in production mode.
# IMPORTANT: Override these with SERVERPOD_PASSWORD_* environment variables!
# Example: SERVERPOD_PASSWORD_database=yourpassword
production:
  database: 'CHANGE_ME'  # Override with SERVERPOD_PASSWORD_database
  redis: ''  # Empty for no password (VPN-protected environment)
  serviceSecret: 'CHANGE_ME'  # Override with SERVERPOD_PASSWORD_serviceSecret

  emailSecretHashPepper: 'CHANGE_ME'  # Override with SERVERPOD_PASSWORD_emailSecretHashPepper
  jwtHmacSha512PrivateKey: 'CHANGE_ME'  # Override with SERVERPOD_PASSWORD_jwtHmacSha512PrivateKey
  jwtRefreshTokenHashPepper: 'CHANGE_ME'  # Override with SERVERPOD_PASSWORD_jwtRefreshTokenHashPepper
