# Production configuration template
# Copy this to production.yaml for Docker deployment
# Override values using SERVERPOD_* environment variables if needed

# Configuration for the main API server.
apiServer:
  port: 8080
  host: 0.0.0.0  # Bind to all interfaces in Docker
  publicHost: localhost  # Override with SERVERPOD_apiServer_publicHost
  publicPort: 443
  publicScheme: https

# Configuration for the Insights server (optional).
insightsServer:
  port: 8081
  host: 0.0.0.0  # Bind to all interfaces in Docker
  publicHost: localhost
  publicPort: 443
  publicScheme: https

# Configuration for the web server (optional).
webServer:
  port: 8082
  host: 0.0.0.0  # Bind to all interfaces in Docker
  publicHost: localhost
  publicPort: 443
  publicScheme: https

# Database configuration
# Default values for Docker deployment
# Service name 'postgresql' resolves in docker-compose network
database:
  host: postgresql  # Docker service name
  port: 5432
  name: memoka
  user: memoka_user
  requireSsl: false  # Internal Docker network
  maxConnectionCount: 10

# Redis configuration
# Default values for Docker deployment
redis:
  enabled: false  # Disabled for initial deployment
  host: redis  # Docker service name
  port: 6379
  requireSsl: false  # Internal Docker network

maxRequestSize: 4294967296  # 4GB - supports 1GB files with JSON List<int> encoding overhead (~4x raw size)

# CORS - CRITICAL: Replace with your actual domain!
cors:
  allowOrigins:
    - "https://your-domain.com"  # REPLACE with actual domain
    - "https://www.your-domain.com"  # REPLACE with actual domain
  allowMethods:
    - GET
    - POST
    - PUT
    - DELETE
    - OPTIONS
  allowHeaders:
    - "Content-Type"
    - "Authorization"
  allowCredentials: true

sessionLogs:
  persistentEnabled: true
  consoleEnabled: false  # Disable console logs in production
  consoleLogFormat: json  # Use JSON for log aggregation

futureCallExecutionEnabled: true

# Rate limiting configuration
rateLimiting:
  enabled: true
  maxRequestsPerMinute: 60
  maxRequestsPerHour: 1000
  burstSize: 10

# Security headers
securityHeaders:
  enabled: true
  hsts: true
  contentSecurityPolicy: "default-src 'self'"
  xFrameOptions: "DENY"
  xContentTypeOptions: "nosniff"
